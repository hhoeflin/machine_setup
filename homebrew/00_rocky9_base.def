BootStrap: docker
From: rockylinux:9

%post
    # Install dependencies for Homebrew
    dnf -y groupinstall "Development Tools" && \
    dnf -y install git procps perl-core glibc-langpack-en && \
    dnf clean all && \
    rm -rf /var/cache/dnf

    mkdir -p /opt/etc/bashrc.d

    # add the bashrc.sh
    config_lines=(
'BASHRC_DIR=/opt/etc/bashrc.d'
'if [ -d "$BASHRC_DIR" ]; then'
'    for script in $(find "$BASHRC_DIR" -type f -name "*.sh" | sort); do'
'       source "$script"'
'    done'
'fi'
)
    > /opt/etc/bashrc.sh
    for line in "${config_lines[@]}"; do
        echo "$line" >> /opt/etc/bashrc.sh
    done

    # add the 00_vars.sh
    config_lines=(
'export LANG=en_US.UTF-8'
'export LC_ALL=en_US.UTF-8'
)
    > /opt/etc/bashrc.d/00_vars.sh
    for line in "${config_lines[@]}"; do
        echo "$line" >> /opt/etc/bashrc.d/00_vars.sh
    done

%environment
    source /opt/etc/bashrc.sh

%runscript
    exec /bin/bash "$@"
