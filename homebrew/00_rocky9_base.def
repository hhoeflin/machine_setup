BootStrap: docker
From: rockylinux:9

%files
    ./00_bashrc.sh /opt/etc/bashrc.sh
    ./00_vars.sh /opt/etc/bashrc.d/00_vars.sh

%post
    # Install dependencies for Homebrew
    dnf -y groupinstall "Development Tools" && \
    dnf -y install git procps perl-core glibc-langpack-en && \
    dnf clean all && \
    rm -rf /var/cache/dnf

    mkdir -p /opt/etc/bashrc.d

%environment
    source /opt/etc/bashrc.sh

%runscript
    exec /bin/bash "$@"
